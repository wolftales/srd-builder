{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wolftales.github.io/srd-builder/planning/module-package.schema.json",
  "version": "0.1.0",
  "title": "Candidate module content package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "publication",
    "blocks",
    "locations",
    "actors",
    "actor_groups",
    "placements",
    "objects",
    "tables",
    "active_features",
    "situations",
    "relationships",
    "adaptation_points",
    "assets",
    "rules"
  ],
  "properties": {
    "meta": {
      "$ref": "#/$defs/packageMeta"
    },
    "publication": {
      "type": "array",
      "items": {
        "$ref": "content.schema.json#/$defs/publicationNode"
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "$ref": "content.schema.json#/$defs/contentBlock"
      }
    },
    "locations": {
      "type": "array",
      "items": {
        "$ref": "content.schema.json#/$defs/location"
      }
    },
    "actors": {
      "type": "array",
      "items": {
        "$ref": "content.schema.json#/$defs/actor"
      }
    },
    "actor_groups": {
      "type": "array",
      "items": {
        "$ref": "content.schema.json#/$defs/actorGroup"
      }
    },
    "placements": {
      "type": "array",
      "items": {
        "$ref": "content.schema.json#/$defs/placement"
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "$ref": "content.schema.json#/$defs/object"
      }
    },
    "tables": {
      "type": "array",
      "items": {
        "$ref": "content.schema.json#/$defs/table"
      }
    },
    "active_features": {
      "type": "array",
      "items": {
        "$ref": "situations.schema.json#/$defs/activeFeature"
      }
    },
    "situations": {
      "type": "array",
      "items": {
        "$ref": "situations.schema.json#/$defs/situation"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "relationships.schema.json#/$defs/relationship"
      }
    },
    "adaptation_points": {
      "type": "array",
      "items": {
        "$ref": "content.schema.json#/$defs/adaptationPoint"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "assets.schema.json#/$defs/asset"
      }
    },
    "rules": {
      "$ref": "rules.schema.json#/$defs/rules"
    }
  },
  "$defs": {
    "packageMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_id",
        "title",
        "content_version",
        "schema_version",
        "builder_version",
        "ruleset",
        "source",
        "relationship_vocabulary"
      ],
      "properties": {
        "package_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "content_version": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "builder_version": {
          "type": "string",
          "minLength": 1
        },
        "ruleset": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "lens_version"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9_]+$"
            },
            "lens_version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format",
            "fingerprint"
          ],
          "properties": {
            "format": {
              "enum": [
                "pdf",
                "epub",
                "html",
                "text",
                "mixed"
              ]
            },
            "fingerprint": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          }
        },
        "relationship_vocabulary": {
          "description": "The relationship types this package uses, grouped by view. Makes the package self-describing so an open vocabulary stays checkable within a package.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "publication": {
              "$ref": "relationships.schema.json#/$defs/relationshipTypeList"
            },
            "world": {
              "$ref": "relationships.schema.json#/$defs/relationshipTypeList"
            },
            "information": {
              "$ref": "relationships.schema.json#/$defs/relationshipTypeList"
            },
            "procedural": {
              "$ref": "relationships.schema.json#/$defs/relationshipTypeList"
            },
            "reference": {
              "$ref": "relationships.schema.json#/$defs/relationshipTypeList"
            },
            "adaptation": {
              "$ref": "relationships.schema.json#/$defs/relationshipTypeList"
            }
          }
        }
      }
    }
  }
}
