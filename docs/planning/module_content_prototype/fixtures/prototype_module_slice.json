  "blocks": [
    {
      "id": "block:settlement_summary",
      "type": "summary",
      "stance": "source_inferred",
      "audience": "gm_only",
      "text": "A small border settlement that can serve as a recurring adventuring base.",
      "source_ref": {
        "section": "Border Settlement"
      }
    },
    {
      "id": "block:steamvault_summary",
      "type": "summary",
      "stance": "source_inferred",
      "audience": "gm_only",
      "text": "A connected underground site whose inhabitants react across room boundaries.",
      "source_ref": {
        "section": "The Steamvault"
      }
    },
    {
      "id": "block:inn_read_aloud",
      "type": "read_aloud",
      "stance": "source_explicit",
      "audience": "player_safe",
      "text": "A patched slate roof and painted walking-stick sign mark a busy roadside inn.",
      "source_ref": {
        "source_key": "S-3"
      }
    },
    {
      "id": "block:inn_gm_detail",
      "type": "gm_detail",
      "stance": "source_explicit",
      "audience": "gm_only",
      "text": "The inn offers rooms, meals, and a common room and is usually operated by a proprietor and two relatives.",
      "source_ref": {
        "source_key": "S-3"
      }
    },
    {
      "id": "block:v1_summary",
      "type": "summary",
      "stance": "source_inferred",
      "audience": "gm_only",
      "text": "An empty connector chamber used by occupants responding to the nearby alarm.",
      "source_ref": {
        "source_key": "V-1"
      }
    },
    {
      "id": "block:v2_read_aloud",
      "type": "read_aloud",
      "stance": "source_explicit",
      "audience": "player_safe",
      "text": "A brass control box stands beside a closed storage coffer in the center of the room.",
      "source_ref": {
        "source_key": "V-2"
      }
    },
    {
      "id": "block:v2_gm_detail",
      "type": "gm_detail",
      "stance": "source_explicit",
      "audience": "gm_only",
      "text": "The coffer carries a concealed alarm. Detecting and disabling it require separate checks; moving or opening it while armed sounds the alarm.",
      "source_ref": {
        "source_key": "V-2"
      }
    },
    {
      "id": "block:v2_alarm_procedure",
      "type": "procedure",
      "stance": "source_explicit",
      "audience": "gm_only",
      "text": "When the alarm sounds, V-3 occupants prepare and V-4 occupants attempt to reach V-2 through V-1.",
      "source_ref": {
        "source_key": "V-2"
      }
    },
    {
      "id": "block:v3_read_aloud",
      "type": "read_aloud",
      "stance": "source_explicit",
      "audience": "player_safe",
      "text": "Ash piles, three sleeping hollows, and a locked iron box fill the warm chamber.",
      "source_ref": {
        "source_key": "V-3"
      }
    },
    {
      "id": "block:v3_gm_detail",
      "type": "gm_detail",
      "stance": "source_explicit",
      "audience": "gm_only",
      "text": "Three Ash Burrowers lair here. Combat can draw surviving V-4 occupants after a random delay. A concealed route connects the rooms.",
      "source_ref": {
        "source_key": "V-3"
      }
    },
    {
      "id": "block:v4_read_aloud",
      "type": "read_aloud",
      "stance": "source_explicit",
      "audience": "player_safe",
      "text": "Five rough bedrolls surround a lidded stone bin.",
      "source_ref": {
        "source_key": "V-4"
      }
    },
    {
      "id": "block:v4_gm_detail",
      "type": "gm_detail",
      "stance": "source_explicit",
      "audience": "gm_only",
      "text": "Five Changed Delvers occupy the chamber. Combat can draw surviving V-3 occupants after a random delay.",
      "source_ref": {
        "source_key": "V-4"
      }
    },
    {
      "id": "block:wandering_procedure",
      "type": "procedure",
      "stance": "source_explicit",
      "audience": "gm_only",
      "text": "Check every thirty minutes of game time. A one-in-six result produces an encounter selected from the site table.",
      "source_ref": {
        "section": "The Steamvault"
      }
    }
  ],
